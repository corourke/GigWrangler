<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs scripts/backup-prod.sh every night at 02:30 (a LaunchAgent, so it runs as you and can
  read your keychain). If the Mac is asleep at 02:30, launchd runs it when the Mac wakes.
  Install and uninstall: docs/technical/deployment.md, "Backups and restore".
  __REPO__ is replaced with the repository's path when it's installed.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gigwrangler.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/backup-prod.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- PostgreSQL 17 client tools from Homebrew (libpq or postgresql@17), then the system. -->
    <key>PATH</key>
    <string>/opt/homebrew/opt/libpq/bin:/opt/homebrew/opt/postgresql@17/bin:/usr/local/opt/libpq/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/com.gigwrangler.backup.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.gigwrangler.backup.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
