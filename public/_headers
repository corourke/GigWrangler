# Cloudflare Pages response headers. See docs/technical/deployment.md, "Security headers".
#
# Security headers on every response. The Content-Security-Policy-Report-Only only reports, in the
# browser console, what a policy would block; it is switched to enforcing once the console on prod
# shows nothing it would break. frame-ancestors is ignored in a report-only policy, so it is sent in
# its own enforced Content-Security-Policy.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=(), microphone=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://qcrzwsazasaojqoqxwnr.supabase.co https://hqnnhtxcxedisasvtbqv.supabase.co https://*.googleusercontent.com; font-src 'self' data:; connect-src 'self' https://qcrzwsazasaojqoqxwnr.supabase.co wss://qcrzwsazasaojqoqxwnr.supabase.co https://hqnnhtxcxedisasvtbqv.supabase.co wss://hqnnhtxcxedisasvtbqv.supabase.co https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; frame-src 'self' blob: https://qcrzwsazasaojqoqxwnr.supabase.co https://hqnnhtxcxedisasvtbqv.supabase.co; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'

# The page itself, so a deploy is picked up on the next load.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# The service worker and the version file must be revalidated on every
# request, or an installed app keeps seeing the old version for hours after a
# deploy (see src/hooks/useAppUpdateNotice.ts). A Cloudflare zone-level cache
# rule can still override these; check with: curl -sI https://gigwrangler.com/sw.js
/sw.js
  Cache-Control: no-cache

/registerSW.js
  Cache-Control: no-cache

/version.json
  Cache-Control: no-cache
