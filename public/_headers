# Cloudflare Pages response headers. See docs/technical/deployment.md, "Security headers".
#
# Security headers on every response. The Content-Security-Policy is enforced: it allows only the
# app's own files and its services (Supabase, Sentry), and refuses framing. It has no 'unsafe-eval':
# zod runs without eval (src/lib/zodConfig.ts).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://qcrzwsazasaojqoqxwnr.supabase.co https://hqnnhtxcxedisasvtbqv.supabase.co https://*.googleusercontent.com; font-src 'self' data:; connect-src 'self' https://qcrzwsazasaojqoqxwnr.supabase.co wss://qcrzwsazasaojqoqxwnr.supabase.co https://hqnnhtxcxedisasvtbqv.supabase.co wss://hqnnhtxcxedisasvtbqv.supabase.co https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; frame-src 'self' blob: https://qcrzwsazasaojqoqxwnr.supabase.co https://hqnnhtxcxedisasvtbqv.supabase.co; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=(), microphone=()

# The page itself, so a deploy is picked up on the next load.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# The service worker and the version file must be revalidated on every
# request, or an installed app keeps seeing the old version for hours after a
# deploy (see src/hooks/useAppUpdateNotice.ts). A Cloudflare zone-level cache
# rule can still override these; check with: curl -sI https://gigwrangler.com/sw.js
/sw.js
  Cache-Control: no-cache

/registerSW.js
  Cache-Control: no-cache

# Push notifications: imported by the service worker, so it updates with it.
/push-sw.js
  Cache-Control: no-cache

/version.json
  Cache-Control: no-cache
